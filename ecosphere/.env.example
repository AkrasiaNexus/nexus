# Supabase: Project Settings > Database > Connection string
# DATABASE_URL = transaction pooler (port 6543) with ?pgbouncer=true ; DIRECT_URL = session/direct (port 5432)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
# 32+ random chars: openssl rand -base64 32
SESSION_SECRET=""
# Code required to sign up as School Administrator
ADMIN_SIGNUP_CODE=""
# Code teachers / health monitors enter to sign up
STAFF_SIGNUP_CODE=""
# Optional: overrides the demo Super Admin password at seed time
SEED_ADMIN_PASSWORD=""
# Second factor admins type in the login "Admin Code" field (leave empty to disable)
ADMIN_LOGIN_CODE=""
