# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL="https://<project-id>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server only. Never commit or expose to the browser.
SUPABASE_SECRET_KEY="sb_secret_..."
# Where reset-password emails link back to
SITE_URL="http://localhost:3000"
# Code required to sign up as School Administrator
ADMIN_SIGNUP_CODE=""
# Code teachers / health monitors enter to sign up
STAFF_SIGNUP_CODE=""
# Second factor admins type in the login "Admin Code" field (leave empty to disable)
ADMIN_LOGIN_CODE=""
# Optional: overrides the demo Super Admin password at seed time
SEED_ADMIN_PASSWORD=""
