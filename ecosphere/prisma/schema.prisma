generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  PARENT
  EMPLOYEE
  SCHOOL_ADMIN
  COMMUNITY
  SUPER_ADMIN
  TEACHER
  HEALTH_MONITOR
}

enum WasteType {
  PLASTIC
  PAPER
  GLASS
  METAL
  ORGANIC
  EWASTE
  TEXTILE
  OTHER
}

enum NoticeKind {
  ANNOUNCEMENT
  CHALLENGE
  PICKUP
  EVENT
  TASK
  HEALTH
}

model School {
  id    String @id @default(cuid())
  name  String @unique
  city  String
  users User[]
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  memberId      String         @unique
  passwordHash  String
  role          Role
  points        Int            @default(0)
  avatar        String         @default("🌱")
  grade         String?
  department    String?
  community     String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  schoolId      String?
  school        School?        @relation(fields: [schoolId], references: [id])
  parentId      String?
  parent        User?          @relation("ParentChild", fields: [parentId], references: [id])
  children      User[]         @relation("ParentChild")
  scans         Scan[]
  purchases     Purchase[]
  notifications Notification[]
  joins         ChallengeJoin[]
  audits        AuditLog[]
  foodLogs      FoodLog[]
  listings      Listing[]
  tasksCreated  Task[]
  taskDones     TaskDone[]
  healthReports HealthReport[]
  rsvps         EventRsvp[]
  events        Event[]
}

model Scan {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  wasteType  WasteType
  confidence Float
  weightKg   Float
  points     Int
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Listing {
  id          String     @id @default(cuid())
  kind        String     @default("REWARD") // REWARD | SELL | DONATE | EXCHANGE
  title       String
  description String
  category    String
  emoji       String
  pricePoints Int
  stock       Int
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  purchases   Purchase[]
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  points    Int
  createdAt DateTime @default(now())
}

model Notification {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NoticeKind
  title     String
  body      String
  createdAt DateTime   @default(now())
}

model Challenge {
  id           String          @id @default(cuid())
  title        String
  description  String
  wasteType    WasteType
  targetKg     Float
  rewardPoints Int
  endsAt       DateTime
  joins        ChallengeJoin[]
}

model ChallengeJoin {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  joinedAt    DateTime  @default(now())

  @@id([userId, challengeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([action, detail, createdAt])
}

model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      String
  category  String // FRUIT_VEG | GRAINS | DAIRY | MEAT | COOKED | BAKERY | OTHER
  kg        Float
  reason    String // LEFTOVER | EXPIRED | SPOILED | PLATE_WASTE | OVERCOOKED
  disposal  String // COMPOST | DONATE | ANIMAL_FEED | BIN
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  className   String
  schoolId    String
  points      Int
  dueAt       DateTime
  createdAt   DateTime   @default(now())
  creatorId   String
  creator     User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  dones       TaskDone[]
}

model TaskDone {
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approved Boolean  @default(false)
  doneAt   DateTime @default(now())

  @@id([taskId, userId])
}

model HealthReport {
  id           String   @id @default(cuid())
  schoolId     String
  className    String
  reporterId   String
  reporter     User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  airQuality   String // GOOD | MODERATE | POOR
  temperatureC Float
  hygiene      Int // 1-5
  cleaning     String // CLEAN | IN_PROGRESS | NEEDS_CLEANING
  wasteLevel   String // LOW | MEDIUM | FULL
  present      Int
  total        Int
  incident     String   @default("")
  createdAt    DateTime @default(now())

  @@index([schoolId, className, createdAt])
}

model Event {
  id          String      @id @default(cuid())
  kind        String // EVENT | WORKSHOP | CAMPAIGN | PROGRAM
  title       String
  description String
  location    String
  startsAt    DateTime
  schoolId    String? // null = open to everyone
  organizerId String?
  organizer   User?       @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  rsvps       EventRsvp[]
}

model EventRsvp {
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}
